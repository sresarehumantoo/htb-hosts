#!/usr/bin/env python3
"""htb-hosts - manage HTB host entries in /etc/hosts without sudo.

All entries live in a delimited managed block; `clean` wipes them. See the
core library at /opt/htb-hosts/htb_hosts.py.
"""

from __future__ import annotations

import argparse
import datetime
import json
import sys
from typing import Optional, Sequence

# Appended, not inserted: sys.path[0] is the script's own directory, so running
# straight out of a source checkout picks up the sibling htb_hosts.py, while the
# installed CLI (in a bindir with no library next to it) falls through to /opt.
sys.path.append("/opt/htb-hosts")
import htb_hosts as hh  # noqa: E402  pylint: disable=wrong-import-position


def _print_entry(entry: hh.Dict) -> None:
    """Print one managed entry in the human-readable list format."""
    hosts = " ".join(entry["hostnames"])
    tag = f"  [tag={entry['tag']}]" if entry.get("tag") else ""
    print(f"  {entry['ip']:<15} {hosts}{tag}")


def _cmd_add(args: argparse.Namespace) -> int:
    ip, hostnames = hh.split_ip_and_hosts(args.args)
    res = hh.add(ip, hostnames, args.tag)
    if args.json:
        print(json.dumps(res))
    else:
        entry = res["entry"]
        print(f"added: {entry['ip']} {' '.join(entry['hostnames'])} [tag={entry['tag']}]")
        for warning in res["warnings"]:
            print(f"warning: {warning}", file=sys.stderr)
    return 0


def _cmd_rm(args: argparse.Namespace) -> int:
    res = hh.remove(args.selector)
    if args.json:
        print(json.dumps(res))
    else:
        print(f"removed {len(res['removed'])} match(es) for {args.selector!r}")
    return 0


def _confirm(removed: list[hh.Dict]) -> bool:
    """Show what a fuzzy `clean --match` is about to remove and ask to proceed.

    The plan and the prompt both go to stderr, so stdout stays clean for the
    result line even here.
    """
    print(f"will remove {len(removed)} entries:", file=sys.stderr)
    for entry in removed:
        hosts = " ".join(entry["hostnames"])
        print(f"  {entry['ip']:<15} {hosts}  [tag={entry['tag']}]", file=sys.stderr)
    if not sys.stdin.isatty():
        raise hh.HostsError("refusing to remove a fuzzy match with no terminal to ask; pass --yes")
    print("proceed? [y/N] ", end="", file=sys.stderr, flush=True)
    try:
        return input().strip().lower() in ("y", "yes")
    except EOFError:
        return False


def _cmd_clean(args: argparse.Namespace) -> int:
    # A fuzzy --match is the one mode where you cannot tell from the command line
    # alone what will go, so show the plan first. The other modes are exact.
    if args.match and not args.yes and not args.json:
        planned = hh.clean(match=args.match, dry_run=True)["removed"]
        if len(planned) > 1 and not _confirm(planned):
            print("aborted", file=sys.stderr)
            return 1
    res = hh.clean(args.tag, args.exclude, args.match)
    if args.json:
        print(json.dumps(res))
        return 0
    if args.exclude:
        scope = f"all except ~{', '.join(args.exclude)}"
    elif args.match:
        scope = f"~{' '.join(args.match)}"
    elif args.tag:
        scope = f"tag={args.tag}"
    else:
        scope = "all managed entries"
    print(f"cleaned {len(res['removed'])} entry/entries ({scope})")
    return 0


def _cmd_get(args: argparse.Namespace) -> int:
    """Print bare ip/hostname values for the matching entries, one per line."""
    data = hh.select(args.pattern, "host" if args.host else "ip", args.index)
    if args.json:
        print(json.dumps(data, indent=2))
        return 0
    values = data["values"]
    if not values:
        print(f"error: no managed entry matches {' '.join(args.pattern)!r}", file=sys.stderr)
        return 1
    if args.numbered:
        width = len(str(len(values)))
        for position, value in enumerate(values, 1):
            print(f"{position:>{width}}  {value}")
        return 0
    print(args.sep.join(values))
    return 0


def _cmd_show(args: argparse.Namespace) -> int:
    data = hh.show_data(args.full, args.pattern)
    if args.json:
        print(json.dumps(data, indent=2))
        return 0
    if args.flat:
        entries = data["entries"]
        if not entries:
            print("(no managed entries)")
            return 0
        print(f"managed entries ({len(entries)}):")
        for entry in entries:
            _print_entry(entry)
        return 0
    boxes = "box" if data["box_count"] == 1 else "boxes"
    entries_word = "entry" if data["managed_count"] == 1 else "entries"
    scope = f" matching {' '.join(args.pattern)!r}" if args.pattern else ""
    print(
        f"HTB hosts — {data['managed_count']} managed {entries_word}"
        f" in {data['box_count']} {boxes}{scope}"
    )
    for tag in sorted(data["groups"]):
        group = data["groups"][tag]
        print(f"\n  {tag} ({len(group)})")
        for entry in sorted(group, key=lambda e: e["ip"]):
            print(f"    {entry['ip']:<15} {' '.join(entry['hostnames'])}")
    if args.full:
        unmanaged = data["unmanaged"]
        print(f"\n  unmanaged / system ({len(unmanaged)}) — outside the managed block")
        for entry in unmanaged:
            print(f"    {entry['ip']:<15} {' '.join(entry['hostnames'])}")
    return 0


def _cmd_migrate(_args: argparse.Namespace) -> int:
    res = hh.migrate()
    print(f"imported {len(res['imported'])} entry/entries into the managed block")
    return 0


def _cmd_retag(args: argparse.Namespace) -> int:
    res = hh.retag()
    if args.json:
        print(json.dumps(res))
    else:
        print(f"retagged {len(res['retagged'])} entry/entries by box name")
        for change in res["retagged"]:
            print(f"  {change['ip']:<15} {change['old']} -> {change['new']}")
    return 0


def _cmd_backup(args: argparse.Namespace) -> int:
    res = hh.backup(args.label)
    if args.json:
        print(json.dumps(res))
    else:
        print(f"saved backup: {res['name']} ({res['bytes']} bytes)")
    return 0


def _cmd_restore(args: argparse.Namespace) -> int:
    if args.list:
        backups = hh.list_backups()
        if args.json:
            print(json.dumps(backups))
        elif not backups:
            print("(no backups)")
        else:
            print(f"backups ({len(backups)}), newest last:")
            for entry in backups:
                when = datetime.datetime.fromtimestamp(entry["mtime"]).strftime("%Y-%m-%d %H:%M:%S")
                print(f"  {entry['kind']:<4} {when}  {entry['bytes']:>6}B  {entry['name']}")
        return 0
    res = hh.restore(args.name)
    if args.json:
        print(json.dumps(res))
    else:
        print(f"restored from {res['restored_from']} ({res['bytes']} bytes)")
    return 0


def _cmd_complete(args: argparse.Namespace) -> int:
    """Emit one candidate word per line for the shell completion scripts.

    Deliberately silent on failure: a malformed /etc/hosts or a missing backup
    directory must never spray errors into somebody's prompt mid-<TAB>.
    """
    try:
        if args.kind == "commands":
            words = args.commands
        else:
            words = hh.complete(args.kind, args.scope)
    except (OSError, ValueError, hh.HostsError):
        return 0
    if words:
        print("\n".join(words))
    return 0


def _cmd_doctor(_args: argparse.Namespace) -> int:
    info = hh.doctor()
    print(json.dumps(info, indent=2))
    return 0 if info["ok"] else 1


# Subcommands offered by tab completion: everything except `complete` itself.
_COMPLETE_KINDS = ("commands",) + hh.COMPLETE_KINDS


def _add_entry_parsers(sub: "argparse._SubParsersAction") -> None:
    """Register the commands that change the managed block."""
    p_add = sub.add_parser("add", help="add/update a host entry")
    p_add.add_argument(
        "args",
        nargs="+",
        metavar="IP/HOSTNAME",
        help=(
            "the IP and one or more hostnames, in any order; a single argument may "
            'carry several, comma or space separated ("a.htb, b.htb")'
        ),
    )
    p_add.add_argument("--tag", help="group tag (defaults to the box name)")
    p_add.add_argument("--json", action="store_true")
    p_add.set_defaults(func=_cmd_add)

    p_rm = sub.add_parser("rm", help="remove a host by hostname or IP")
    p_rm.add_argument("selector")
    p_rm.add_argument("--json", action="store_true")
    p_rm.set_defaults(func=_cmd_rm)

    p_clean = sub.add_parser(
        "clean",
        help="remove managed entries (all, or by --tag/--match/--exclude)",
        description=(
            "With no flag, wipe the whole managed block. --tag removes one box by its "
            "exact tag, --match removes what `get` would show for the same patterns, "
            "and --exclude is the inverse keep-list."
        ),
    )
    scope = p_clean.add_mutually_exclusive_group()
    scope.add_argument("--tag", help="only remove entries with this exact tag")
    scope.add_argument(
        "--match",
        nargs="+",
        metavar="PATTERN",
        help="remove entries matching every pattern (same selector as `get`)",
    )
    scope.add_argument(
        "--exclude",
        action="append",
        metavar="PATTERN",
        help="remove everything EXCEPT fuzzy matches (repeatable), e.g. --exclude forest",
    )
    p_clean.add_argument(
        "-y", "--yes", action="store_true", help="skip the --match confirmation prompt"
    )
    p_clean.add_argument("--json", action="store_true")
    p_clean.set_defaults(func=_cmd_clean)


def _add_query_parsers(sub: "argparse._SubParsersAction") -> None:
    """Register the read-only commands that report or select entries."""
    p_show = sub.add_parser(
        "show",
        help="human-readable view of the managed entries, optionally filtered",
        description=(
            "Print the managed entries grouped by box, narrowed to PATTERN if given. "
            "This is the view for reading; use `get` when you need values to pipe."
        ),
    )
    p_show.add_argument(
        "pattern",
        nargs="*",
        metavar="PATTERN",
        help="fuzzy match against ip/tag/hostname (omit for everything)",
    )
    p_show.add_argument("--flat", action="store_true", help="one line per entry, ungrouped")
    p_show.add_argument("--full", action="store_true", help="also list unmanaged/system entries")
    p_show.add_argument("--json", action="store_true")
    p_show.set_defaults(func=_cmd_show)

    p_get = sub.add_parser(
        "get",
        help="print bare ip/hostname values for matching entries (for $(...) piping)",
        description=(
            "Print just the values of the entries matching PATTERN, one per line, so "
            "they can be piped straight into other tools: nmap $(htb-hosts get example), "
            "ffuf -u http://$(htb-hosts get example --host)/FUZZ"
        ),
    )
    p_get.add_argument(
        "pattern",
        nargs="*",
        metavar="PATTERN",
        help="fuzzy match against ip/tag/hostname (omit for every managed entry)",
    )
    p_get.add_argument("--host", action="store_true", help="print hostnames instead of IPs")
    p_get.add_argument(
        "-i",
        "--index",
        metavar="SPEC",
        help="keep only these 1-based lines: 2, -1 (last), 2-4, or 1,3",
    )
    shape = p_get.add_mutually_exclusive_group()
    shape.add_argument(
        "-n",
        "--numbered",
        action="store_true",
        help="number the values so you can pick one with --index",
    )
    shape.add_argument(
        "--sep",
        default="\n",
        metavar="S",
        help="join values with S instead of a newline (e.g. --sep , for nmap)",
    )
    p_get.add_argument("--json", action="store_true")
    p_get.set_defaults(func=_cmd_get)


def _add_maintenance_parsers(sub: "argparse._SubParsersAction") -> None:
    """Register the housekeeping commands (migrate/retag/backup/restore/doctor)."""
    p_migrate = sub.add_parser("migrate", help="one-time import of existing entries into the block")
    p_migrate.set_defaults(func=_cmd_migrate)

    p_retag = sub.add_parser("retag", help="recompute all tags from box name (fixes tag=imported)")
    p_retag.add_argument("--json", action="store_true")
    p_retag.set_defaults(func=_cmd_retag)

    p_backup = sub.add_parser("backup", help="save an explicit snapshot of /etc/hosts")
    p_backup.add_argument("--label", help="label appended to the backup filename")
    p_backup.add_argument("--json", action="store_true")
    p_backup.set_defaults(func=_cmd_backup)

    p_restore = sub.add_parser("restore", help="restore /etc/hosts from a snapshot")
    p_restore.add_argument("name", nargs="?", help="backup name/substring (default: most recent)")
    p_restore.add_argument("--list", action="store_true", help="list available backups")
    p_restore.add_argument("--json", action="store_true")
    p_restore.set_defaults(func=_cmd_restore)

    p_doctor = sub.add_parser("doctor", help="check writability / show the setfacl fix")
    p_doctor.set_defaults(func=_cmd_doctor)

    # Hidden: the data source for the shell completion scripts. Passing no
    # `help` at all is what keeps it out of the command list (argparse prints a
    # literal "==SUPPRESS==" row for help=SUPPRESS on a subparser).
    p_complete = sub.add_parser("complete")
    p_complete.add_argument("kind", choices=_COMPLETE_KINDS)
    p_complete.add_argument(
        "scope",
        nargs="*",
        metavar="PATTERN",
        help="patterns already typed, to scope the candidates to that selection",
    )
    p_complete.set_defaults(func=_cmd_complete)


def _build_parser() -> argparse.ArgumentParser:
    """Construct the argument parser with all subcommands."""
    parser = argparse.ArgumentParser(
        prog="htb-hosts",
        description="Add/remove HTB hosts in /etc/hosts (no sudo needed).",
    )
    # metavar keeps the hidden `complete` command out of the usage line too.
    sub = parser.add_subparsers(dest="cmd", required=True, metavar="COMMAND")
    _add_entry_parsers(sub)
    _add_query_parsers(sub)
    _add_maintenance_parsers(sub)

    # Every namespace carries the completable command names
    # `complete` itself excluded) so `complete commands` needs no introspection.
    parser.set_defaults(commands=sorted(n for n in sub.choices if n != "complete"))
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    """CLI entry point. Returns a process exit code."""
    args = _build_parser().parse_args(argv)
    try:
        return args.func(args)
    except hh.HostsError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
